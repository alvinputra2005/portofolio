# Salin ke .env.local. Jangan commit .env.local atau kirim kunci lewat chat.
# Supabase Dashboard > Project Settings / Connect: Project URL dan Publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bootstrap/migrasi dan akses server dalam mode lokal tanpa login.
# CRUD dengan login normal tetap menggunakan sesi pengguna dan RLS.
# Dashboard > Settings > API Keys > Secret key. Legacy service_role juga diterima.
SUPABASE_SECRET_KEY=
# Email akun aplikasi di Authentication > Users, bukan otomatis akun dashboard.
SUPABASE_ADMIN_EMAIL=

# Hanya next dev di localhost. Production tetap memerlukan login.
LOCAL_ADMIN_NO_AUTH=false

# Opsional, Google AI Studio. Hanya dipakai endpoint server admin.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
